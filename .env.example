# Server Configuration
PORT=5000

# Database Configuration (MongoDB Atlas connection string or local MongoDB)
MONGODB_URI=mongodb://localhost:27017/payment_tracking

# Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_change_in_production_123!

# Email Service Configuration (SMTP)
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Recipient Email for Receipts & Payment Notifications
TARGET_EMAIL=personal-email@example.com
